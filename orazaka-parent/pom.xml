<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Orazaka inherits the Krizaka build: Maven Central metadata, Java 21, formatting, tests,
         coverage, the enforced toolchain and the `release` profile (krizaka/krizaka-build). What
         stays here is what is Orazaka's own: Spring AI, the Orazaka BOM, the .env-driven profiles
         and SonarCloud. -->
    <parent>
        <groupId>com.krizaka</groupId>
        <artifactId>krizaka-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../krizaka/krizaka-build/krizaka-parent/pom.xml</relativePath>
    </parent>

    <groupId>com.krizaka.orazaka</groupId>
    <artifactId>orazaka-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>orazaka-parent</name>
    <description>Orazaka parent POM: Spring Boot / Spring AI BOMs, the Krizaka BOM, the Orazaka BOM (every component at one platform version) and the Orazaka profiles, on top of the Krizaka build conventions.</description>
    <url>https://github.com/krizaka/orazaka-build</url>

    <scm>
        <url>https://github.com/krizaka/orazaka-build</url>
        <connection>scm:git:https://github.com/krizaka/orazaka-build.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/orazaka-build.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/krizaka/orazaka/issues</url>
    </issueManagement>

    <properties>
        <!-- The Krizaka artifacts (build, platform kit, users, notifications, billing) Orazaka
             is built on — one version, imported through krizaka-bom below. -->
        <krizaka.version>0.1.0-SNAPSHOT</krizaka.version>

        <!-- GitHub Packages repository this module is published to. Every Orazaka repository
             overrides it with its own name (krizaka/<repository>). -->
        <orazaka.repository>orazaka-build</orazaka.repository>

        <!-- Versions -->
        <!-- Spring AI 2.0 migration (ADR-030): Spring AI 2.0.0 GA requires Spring Boot 4 +
             Spring Framework 7 + Jackson 3. DELIBERATE override of the former AGENTS.md §11
             pin to the 3.5.0 line — update §11 accordingly. Verify the exact Boot 4 patch
             against the BOM if resolution fails. No -SNAPSHOT (GA only). -->
        <!-- spring-boot.version comes from krizaka-parent, so Orazaka and the Krizaka artifacts
             it consumes are always built against the same Boot line. -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <graphql-spring-boot.version>15.0.0</graphql-spring-boot.version>
        <archunit.version>1.3.0</archunit.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <node.version>v24.11.1</node.version>

        <!-- SonarQube Cloud -->
        <sonar.organization>krizaka</sonar.organization>
        <sonar.projectKey>${sonar.organization}_${orazaka.repository}</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.java.source>21</sonar.java.source>
        <sonar.coverage.jacoco.xmlReportPaths>**/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- 🔑 Token injected from env on CI or from .env locally -->
        <sonar.token>${env.SONAR_TOKEN}</sonar.token>

        <!-- 🌿 Branch detection: auto-resolved from git or overridden via -Dsonar.branch.name -->
        <sonar.branch.name></sonar.branch.name>

        <!-- 🚫 Exclusions: scratch files, test fixtures, generated code -->
        <sonar.exclusions>
            scratch/**/*,
            **/node_modules/**/*,
            **/dist/**/*,
            **/.next/**/*,
            **/target/**/*
        </sonar.exclusions>

        <!-- 📊 Coverage exclusions: boilerplate not requiring test coverage -->
        <sonar.coverage.exclusions>
            **/entity/**,
            **/converter/**,
            **/config/**,
            **/domain/model/**,
            **/*Application.java,
            **/Mapper.java,
            **/*Mapper.java,
            **/*Controller.java,
            **/core/infrastructure/**
        </sonar.coverage.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.krizaka</groupId>
                <artifactId>krizaka-bom</artifactId>
                <version>${krizaka.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal Modules -->
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-billing-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-billing-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-studio-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-assets</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-studio-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-jobs-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-persistence-app-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-persistence-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-interceptors</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-business</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-persistence-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-notification-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Shared Test Support -->
            <dependency>
                <groupId>com.krizaka.orazaka</groupId>
                <artifactId>orazaka-test-support</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Architectural Testing -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — krizaka/${orazaka.repository}</name>
            <url>https://maven.pkg.github.com/krizaka/${orazaka.repository}</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Repackage plugin version follows the Boot BOM — app poms must not pin it. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <!-- Every service says which build it is. Without this /actuator/info is
                             `{}`, and a stale JVM left over from a failed e2e run answers on the
                             right port with the wrong code — a green from yesterday's build that
                             nothing in the harness could distinguish from today's. The e2e
                             identity check compares what a service reports against the
                             build-info.properties on disk and refuses to test a process that is
                             not this build. -->
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>4.0.0.4121</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.2.1</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${maven.multiModuleProjectDirectory}/${env.file}</file>
                            </files>
                            <quiet>true</quiet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>






        </plugins>
    </build>

    <!-- ====================================================================
         ADR-040 V2: Industrial Maven Profile Matrix — dev / staging / prod
         dev     → ./mvnw compile            (default, skips E2E)
         staging → ./mvnw verify -P staging   (full E2E orchestration)
         prod    → ./mvnw package -P prod     (production dotenv, skips E2E)
         ==================================================================== -->
    <profiles>
        <profile>
            <id>dev</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <env.file>.env</env.file>
                <skip.e2e>true</skip.e2e>
            </properties>
        </profile>
        <profile>
            <id>staging</id>
            <properties>
                <env.file>.env</env.file>
                <skip.e2e>false</skip.e2e>
                <!-- E2E toolchain versions — only materialized in staging -->
                <docker-maven-plugin.version>0.45.1</docker-maven-plugin.version>
                <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
                <node.version>v24.11.1</node.version>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <env.file>.env.prod</env.file>
                <skip.e2e>true</skip.e2e>
            </properties>
        </profile>
    </profiles>

</project>